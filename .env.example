# Copy this file to `.env` and fill in values.
#   cp .env.example .env

# --- LLM (required for extraction/QA; not needed for the auth API) ---
ANTHROPIC_API_KEY=sk-ant-...
DIRIS_MODEL=claude-opus-5
DIRIS_STORE_DIR=data/store

# --- Backup LLM providers (NOT yet used by any code) ---
# DIRIS calls Claude via the Anthropic SDK. These keys are parked here for a
# future provider-fallback layer; nothing reads them until that's built.
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Database (MySQL) ---
# Matches docker-compose.yml. For a native MySQL, change host/port/creds here only.
DIRIS_DATABASE_URL=mysql+pymysql://diris:diris@localhost:3307/diris

# --- Auth / JWT ---
# CHANGE THIS. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
DIRIS_JWT_SECRET=dev-only-insecure-secret-change-me
DIRIS_JWT_ALG=HS256
DIRIS_JWT_EXPIRE_MINUTES=60

# --- Document uploads ---
DIRIS_UPLOAD_DIR=data/uploads
DIRIS_MAX_UPLOAD_MB=25
DIRIS_ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.md,.html

# --- Vector store (ChromaDB, local persistent) ---
DIRIS_CHROMA_DIR=data/chroma
DIRIS_CHROMA_COLLECTION=diris_chunks

# --- Entity extraction & resolution (Milestone 6; needs ANTHROPIC_API_KEY) ---
DIRIS_EXTRACTION_MODEL=claude-sonnet-5
DIRIS_CHROMA_ENTITY_COLLECTION=diris_entities
DIRIS_RESOLUTION_THRESHOLD=0.83

# --- Knowledge graph (Neo4j, Milestone 7) ---
DIRIS_NEO4J_URI=bolt://localhost:7687
DIRIS_NEO4J_USER=neo4j
DIRIS_NEO4J_PASSWORD=dirispassword

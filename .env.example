# Copy this file to `.env` and fill in your key.
#   cp .env.example .env

# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Model used for knowledge extraction and question answering.
# Default is Claude Opus 5 (highest quality). For cheaper bulk extraction
# over large corpora you may switch to claude-sonnet-5 or claude-haiku-4-5.
DIRIS_MODEL=claude-opus-5

# Where the knowledge graph + vector index are persisted.
DIRIS_STORE_DIR=data/store
